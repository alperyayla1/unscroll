{
  "manifest_version": 3,
  "name": "Unscroll",
  "version": "1.0.0",
  "description": "Blocks YouTube Shorts, Reels, TikTok and other short-video feeds. Works with the Unscroll desktop app.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtube-nocookie.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://snapchat.com/*",
    "*://*.snapchat.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://linkedin.com/*",
    "*://*.linkedin.com/*",
    "*://tumblr.com/*",
    "*://*.tumblr.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://youtu.be/*",
    "*://fb.watch/*",
    "*://redd.it/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.snapchat.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "rules.js",
        "text.js",
        "ui.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}