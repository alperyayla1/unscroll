{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unshorts",
  "mainBinaryName": "unshorts",
  "version": "1.0.0",
  "identifier": "com.darkskystudios.unshorts",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Unshorts",
        "width": 380,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DarkSky Studios",
    "copyright": "© DarkSky Studios",
    "shortDescription": "Block Shorts, Reels and doomscrolling",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/unshorts-host"],
    "resources": {
      "../extension/": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
